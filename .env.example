# Copy this file to .env for local secrets used by docker compose.
# Values in docker-compose.yml are safe defaults; real API keys stay only in your local .env.

EXERCISES_API_HOST=
EXERCISES_API_KEY=

API_SECURITY_TOKEN_SECRET=local-dev-secret
# Segredo das consultas entre serviços (fitness -> users). Trocar em produção.
INTERNAL_TOKEN=local-internal-token
GOOGLE_CLIENT_ID=

# URL pública usada nos links de e-mail (produção: https://seudominio.com).
# Em dev, http://localhost cai no nginx, que serve a página central de reset.
SERVER_URL=http://localhost
# Rotas do frontend que tratam os links de e-mail (token vem em ?token=...)
APP_ACCESS_PATH=/user/app-access
PASSWORD_RESET_PATH=/user/reset-password
# Página do web que recebe o token do convite aluno <-> profissional (?invite=...).
FITNESS_INVITE_PATH=/app/fitness/?invite=
# Validade do convite em horas (padrão 168 = 7 dias).
FITNESS_INVITE_TTL_HOURS=168
# URL exibida no Spring Boot Admin. Vazio = SERVER_URL + /fitness/swagger/index.html.
SWAGGER_PUBLIC_URL=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Somente produção (docker-compose.prod.yml). Obrigatórios: POSTGRES_PASSWORD e GHCR_IMAGE_PREFIX.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=
GHCR_IMAGE_PREFIX=
IMAGE_TAG=latest
