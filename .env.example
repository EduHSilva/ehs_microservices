# Copy this file to .env for local secrets used by docker compose.
# Values in docker-compose.yml are safe defaults; real API keys stay only in your local .env.

FOOD_API_HOST=
FOOD_API_KEY=
FOOD_APP_ID=
GPT_API_URL=
GPT_API_KEY=
JWT_SECRET=local-dev-secret
EXERCISES_API_HOST=
EXERCISES_API_KEY=

API_SECURITY_TOKEN_SECRET=local-dev-secret
GOOGLE_CLIENT_ID=

# URL pública usada nos links de e-mail (produção: https://seudominio.com).
# Em dev, http://localhost cai no nginx, que serve a página central de reset.
SERVER_URL=http://localhost
# Rotas do frontend que tratam os links de e-mail (token vem em ?token=...)
APP_ACCESS_PATH=/user/app-access
PASSWORD_RESET_PATH=/user/reset-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
